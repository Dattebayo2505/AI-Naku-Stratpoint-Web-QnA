LCX_ROOT_USERNAME=
LCX_ROOT_PASSWORD=
NON_ROOT_USERNAME=
NON_ROOT_PASSWORD=
# Host + the 2 ports the group is allotted on the LXC (bare-metal run: 1 for the API/BE, 1 for the UI/FE)
PUBLIC_IP_ADDRESS=
PORT=

# RAG — retrieval (defaults in stratpoint_rag/rag/config.py; blank = use default)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
CHROMA_DIR=
CHROMA_COLLECTION=

# RAG — generation LLM (NVIDIA-hosted NIM, OpenAI-compatible chat/completions)
# Blank = the config.py default, meta/llama-3.1-8b-instruct. One key works for
# any NIM model, so switching models needs only this line.
LLM_MODEL=
NVIDIA_API_KEY=nvapi-
LLM_TIMEOUT=300

# docparse — vision model for transcribing uploaded client briefs.
# One key works for any NIM model, so NVIDIA_VISION_API_KEY is OPTIONAL: blank
# falls back to NVIDIA_API_KEY. A second key is only a quota lever (40 RPM per
# model). Blank VISION_MODEL = the docparse/config.py default.
VISION_MODEL=
NVIDIA_VISION_API_KEY=

# docparse — uploads + parsing. Defaults live in stratpoint_rag/docparse/config.py;
# blank = use the default, shown after each name:
#   UPLOAD_DIR                    data/uploads
#   UPLOAD_TTL_SECONDS            3600
#   UPLOAD_MAX_BYTES              25000000
#   DOCPARSE_MAX_PAGES            20
#   DOCPARSE_CONCURRENCY          4
#   DOCPARSE_TEXT_LAYER_MIN_CHARS 100   (rasterize a page only below this many chars)
UPLOAD_DIR=
UPLOAD_TTL_SECONDS=
UPLOAD_MAX_BYTES=
DOCPARSE_MAX_PAGES=
DOCPARSE_CONCURRENCY=
DOCPARSE_TEXT_LAYER_MIN_CHARS=

# docparse hop 2 — turning the transcription into structured requirements.
# Runs on LLM_MODEL (above), not VISION_MODEL. Defaults, blank = use them:
#   DOCPARSE_EXTRACTION_TOKEN_BUDGET 12000  (above this, split into page groups)
#   DOCPARSE_EXTRACTION_GROUP_PAGES  5      (pages per group when it splits)
# Raising the budget is NOT free: extraction quality collapses long before the
# model's nominal 128k window, and it fails silently — requirements buried late
# in a long brief are simply dropped from an otherwise well-formed answer.
DOCPARSE_EXTRACTION_TOKEN_BUDGET=
DOCPARSE_EXTRACTION_GROUP_PAGES=

# UI — base URL of the API (blank = http://localhost:8000; docker-compose sets http://api:8000)
STRATPOINT_API_URL=

# LLMOps — JSONL trace sink (Component #8); blank = defaults in stratpoint_rag/llmops
LLMOPS_ENABLED=
LLMOPS_LOG_PATH=